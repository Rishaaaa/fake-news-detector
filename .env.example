# ---------------------------------------------------------------------------
# Environment configuration template.
#
# Copy this file to `.env` and adjust the values:
#     cp .env.example .env          (macOS / Linux)
#     copy .env.example .env        (Windows)
#
# `.env` is listed in .gitignore, so your real values are never committed.
# Every setting below is optional - the application has working defaults.
# ---------------------------------------------------------------------------

# Secret key used to sign Flask session cookies and flash messages.
# Generate a strong value with:
#     python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-to-a-random-64-character-hex-string

# Set to 1 only while developing. Never enable debug mode on a public server:
# it exposes an interactive Python console to anyone who can trigger an error.
FLASK_DEBUG=0

# Network interface and port for the development server.
FLASK_HOST=127.0.0.1
FLASK_PORT=5000

# Pin a specific algorithm instead of letting cross-validation choose.
# Leave unset (the default) for data-driven selection. Valid values:
#     Logistic Regression | Naive Bayes | Linear SVM | Random Forest
# PRIMARY_MODEL=Logistic Regression
